# ── Redis (used from Phase 6 onward: rate limiting, BullMQ) ─
REDIS_URL=redis://localhost:6379

# ── Auth ────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Rate limiting (internal CRM safety rule, NOT a Meta limit) ─
GENERAL_RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# ── Conversation / customer-service window ─────────────
# Default is a common industry figure, NOT verified against current Meta
# documentation. Confirm and adjust before Phase 4 (real WhatsApp Cloud API).
CUSTOMER_SERVICE_WINDOW_HOURS=24

