# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# ── Database (PostgreSQL) ──────────────────────────────
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=crm_whatsapp
# DB_USER=postgres
# DB_PASSWORD=admin
# DB_SSL=false

DB_HOST=ep-dark-moon-axlz1a0c-pooler.c-4.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
