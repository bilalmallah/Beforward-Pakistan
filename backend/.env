# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# ── Database (PostgreSQL) ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crm_whatsapp
DB_USER=postgres
DB_PASSWORD=admin
DB_SSL=false

# ── Redis (used from Phase 6 onward: rate limiting, BullMQ) ─
REDIS_URL=redis://localhost:6379

# ── Auth ────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Rate limiting (internal CRM safety rule, NOT a Meta limit) ─
GENERAL_RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# ── Conversation / customer-service window ─────────────
# Default is a common industry figure, NOT verified against current Meta
# documentation. Confirm and adjust before Phase 4 (real WhatsApp Cloud API).
CUSTOMER_SERVICE_WINDOW_HOURS=24

# ── Internal CRM safety rules (NOT Meta-enforced limits) ─
# All numbers here are OUR CRM's rules, configurable, never to be
# described as Meta policy (spec section 62).
INACTIVE_TEMPLATE_ATTEMPT_LIMIT=100
MANAGER_OVERRIDE_ATTEMPTS=10
CAMPAIGN_MESSAGES_PER_MINUTE=6

# ── WhatsApp Business Platform / Meta Cloud API ────────
# NOT required for Phase 1 (Auth/RBAC/Users/Teams).
# These become required starting Phase 4 (WhatsApp integration).
# Never expose these values to the frontend.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
